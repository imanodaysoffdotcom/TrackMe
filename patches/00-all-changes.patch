+
+    <!--
+      Visual Analysis owns its React Flow graph. React + @xyflow/react are loaded
+      LAZILY (dynamic import on first tab open), mirroring the on-demand Leaflet
+      injection — no build step, no cost until the tab is used. esm.sh serves a single
+      pinned React 18.3.1 to React Flow (deps=) so there is exactly one React instance.
+    -->
+    <script type="module">
+      (() => {
+        const ESM = "https://esm.sh/";
+        const REACT = "react@18.3.1";
+        const RF = "@xyflow/react@12.11.0";
+        const DEPS = "deps=react@18.3.1,react-dom@18.3.1";
+
+        let libs = null; // cached imported modules
+        let comp = null; // cached React components (stable nodeTypes)
+        let root = null; // current React root
+        let mounted = false;
+
+        // Same algorithm as pcDrawCanvas: 12x12, white=1/black=0, MSB-first row-major.
+        const drawSphbi = (canvas, bits, size) => {
+          const n = size || 12;
+          canvas.width = n;
+          canvas.height = n;
+          const ctx = canvas.getContext("2d");
+          const img = ctx.createImageData(n, n);
+          bits = bits || "";
+          for (let i = 0; i < n * n && i < bits.length; i++) {
+            const on = bits[i] === "1" ? 255 : 0;
+            img.data[i * 4] = on;
+            img.data[i * 4 + 1] = on;
+            img.data[i * 4 + 2] = on;
+            img.data[i * 4 + 3] = 255;
+          }
+          ctx.putImageData(img, 0, 0);
+        };
+
+        async function ensureLibs() {
+          if (libs) return libs;
+          if (!document.getElementById("va-rf-css")) {
+            const l = document.createElement("link");
+            l.id = "va-rf-css";
+            l.rel = "stylesheet";
+            l.href = ESM + RF + "/dist/style.css";
+            document.head.appendChild(l);
+          }
+          const ReactNS = await import(ESM + REACT);
+          const React = ReactNS.default || ReactNS; // canonical React object (hooks + createElement)
+          const ReactDOMClient = await import(ESM + "react-dom@18.3.1/client");
+          const htmMod = await import(ESM + "htm@3.1.1");
+          const xy = await import(ESM + RF + "?" + DEPS);
+          const h = htmMod.default.bind(React.createElement);
+          libs = { React, h, xy, createRoot: ReactDOMClient.createRoot };
+          return libs;
+        }
+
+        const lastSeg = (s) => (s.indexOf(".") >= 0 ? s.split(".").pop() : s);
+        const shortLabel = (d) => {
+          const ls = d.labels || [];
+          const pretty = (s) => (d.side === "left" ? lastSeg(s) : s);
+          if (ls.length === 0) return d.device || d.bits.slice(0, 6);
+          if (ls.length === 1) return pretty(ls[0]);
+          return pretty(ls[0]) + " +" + (ls.length - 1);
+        };
+
+        function buildComponents(mods) {
+          if (comp) return comp;
+          const { React, h, xy } = mods;
+          const { Handle, Position, ReactFlow, Background, Controls } = xy;
+
+          function SphbiNode(props) {
+            const d = props.data;
+            const ref = React.useRef(null);
+            React.useEffect(() => {
+              if (ref.current) drawSphbi(ref.current, d.bits, d.size || 12);
+            }, [d.bits]);
+            const accent = d.side === "left" ? "#6366f1" : "#14b8a6";
+            const card = {
+              display: "flex", flexDirection: "column", alignItems: "center", gap: "2px",
+              padding: "4px", border: "1px solid " + accent, borderRadius: "6px",
+              background: "rgba(127,127,127,0.10)", width: "120px",
+            };
+            return h`<div style=${card} title=${(d.labels || []).join(", ")}>
+              ${d.side === "left"
+                ? h`<${Handle} type="source" position=${Position.Right} id="out" />`
+                : h`<${Handle} type="target" position=${Position.Left} id="in" />`}
+              <canvas ref=${ref} width="12" height="12"
+                style=${{ width: "44px", height: "44px", imageRendering: "pixelated", border: "1px solid rgba(0,0,0,0.25)" }}></canvas>
+              <div style=${{ fontSize: "9px", lineHeight: "1.15", textAlign: "center", wordBreak: "break-word", maxWidth: "112px" }}>
+                ${shortLabel(d)}
+              </div>
+              ${d.count > 1 ? h`<div style=${{ fontSize: "9px", fontWeight: "bold", color: accent }}>×${d.count}</div>` : null}
+            </div>`;
+          }
+
+          function Ja4Node(props) {
+            const d = props.data;
+            const box = {
+              display: "flex", flexDirection: "column", alignItems: "center", gap: "3px",
+              padding: "8px 10px", border: "2px solid #4f46e5", borderRadius: "8px",
+              background: "rgba(99,102,241,0.15)", width: "210px",
+            };
+            return h`<div style=${box}>
+              <${Handle} type="target" position=${Position.Left} id="in" />
+              <div style=${{ fontWeight: "bold", fontSize: "11px", letterSpacing: "0.05em" }}>JA4</div>
+              <div style=${{ fontFamily: "monospace", fontSize: "10px", wordBreak: "break-all", textAlign: "center" }}>${d.ja4}</div>
+              <div style=${{ fontSize: "9px", opacity: 0.8 }}>${d.left} scraper · ${d.right} device images</div>
+              <${Handle} type="source" position=${Position.Right} id="out" />
+            </div>`;
+          }
+
+          const nodeTypes = { sphbi: SphbiNode, ja4: Ja4Node };
+
+          // Manual two-column layout; each side wraps into sub-columns past PER_COL so a
+          // large right side (hundreds of device images) stays navigable via pan/zoom.
+          const PER_COL = 16, V_GAP = 84, H_GAP = 210;
+          function layout(data) {
+            const left = data.left || [], right = data.right || [];
+            const nodes = [], edges = [];
+            const rows = Math.max(Math.min(left.length, PER_COL), Math.min(right.length, PER_COL), 1);
+            const centerY = ((rows - 1) * V_GAP) / 2;
+            nodes.push({
+              id: "ja4", type: "ja4", position: { x: 0, y: centerY }, draggable: false,
+              data: { ja4: data.ja4, left: data.left_total, right: data.right_total },
+            });
+            left.forEach((n, i) => {
+              const col = Math.floor(i / PER_COL), rowN = i % PER_COL, id = "L" + i;
+              nodes.push({ id, type: "sphbi", position: { x: -(H_GAP * (col + 1)) - 170, y: rowN * V_GAP }, data: { ...n, side: "left" } });
+              edges.push({ id: "e" + id, source: id, sourceHandle: "out", target: "ja4", targetHandle: "in", style: { stroke: "#6366f1" } });
+            });
+            right.forEach((n, i) => {
+              const col = Math.floor(i / PER_COL), rowN = i % PER_COL, id = "R" + i;
+              nodes.push({ id, type: "sphbi", position: { x: H_GAP * (col + 1) + 170, y: rowN * V_GAP }, data: { ...n, side: "right" } });
+              edges.push({ id: "e" + id, source: "ja4", sourceHandle: "out", target: id, targetHandle: "in", style: { stroke: "#14b8a6" } });
+            });
+            return { nodes, edges };
+          }
+
+          function App(props) {
+            const data = props.data;
+            const { nodes, edges } = React.useMemo(() => layout(data), [data]);
+            const rf = React.useRef(null);
+            const fit = () => rf.current && requestAnimationFrame(() => rf.current.fitView({ padding: 0.2 }));
+            const onInit = React.useCallback((inst) => { rf.current = inst; fit(); }, []);
+            React.useEffect(() => { fit(); }, [data]);
+            React.useEffect(() => {
+              const onShown = () => setTimeout(fit, 60);
+              window.addEventListener("va:shown", onShown);
+              return () => window.removeEventListener("va:shown", onShown);
+            }, []);
+            return h`<${ReactFlow} nodes=${nodes} edges=${edges} nodeTypes=${nodeTypes}
+              onInit=${onInit} minZoom=${0.05} fitView>
+              <${Background} /><${Controls} /><//>`;
+          }
+
+          comp = { App };
+          return comp;
+        }
+
+        function teardown() {
+          if (root) { root.unmount(); root = null; }
+          const host = document.getElementById("va-flow");
+          if (host) host.innerHTML = "";
+        }
+
+        async function render(ja4) {
+          const info = document.getElementById("va-info");
+          const host = document.getElementById("va-flow");
+          if (!ja4) { teardown(); if (info) info.textContent = ""; return; }
+          info.textContent = "loading…";
+          let mods;
+          try { mods = await ensureLibs(); }
+          catch (e) { info.textContent = "failed to load React Flow: " + e.message; return; }
+          let data;
+          try { data = await fetch("/api/sphbi/by-ja4?ja4=" + encodeURIComponent(ja4)).then((r) => r.json()); }
+          catch (e) { info.textContent = "fetch failed: " + e.message; return; }
+          if (data.error) { info.textContent = "error: " + data.error; return; }
+          const lt = data.left_total || 0, rt = data.right_total || 0;
+          if (lt === 0 && rt === 0) {
+            teardown();
+            host.innerHTML = '<div style="padding:1rem;color:#888;font-size:0.9rem">No SPHBI images are linked to this JA4 yet.</div>';
+            info.textContent = "";
+            return;
+          }
+          info.textContent =
+            lt + " scraper image" + (lt === 1 ? "" : "s") + " · " +
+            rt + " device image" + (rt === 1 ? "" : "s") +
+            (data.left_truncated || data.right_truncated ? " (capped at 400/side)" : "");
+          const { h, createRoot } = mods;
+          const { App } = buildComponents(mods);
+          if (!root) { host.innerHTML = ""; root = createRoot(host); }
+          root.render(h`<${App} data=${data} />`);
+        }
+
+        async function mount() {
+          const sel = document.getElementById("va-ja4-select");
+          if (!sel) return;
+          if (!mounted) {
+            mounted = true;
+            try {
+              // Only JA4s that actually have labeled SPHBI images (so a pick can't
+              // render an empty graph); each carries per-side image counts.
+              const vals = await fetch("/api/sphbi/ja4values").then((r) => r.json());
+              const list = Array.isArray(vals) ? vals : [];
+              sel.innerHTML = "";
+              const ph = document.createElement("option");
+              ph.value = "";
+              ph.textContent = list.length
+                ? "— select one of " + list.length + " JA4s with images —"
+                : "— no JA4s have SPHBI images yet —";
+              sel.appendChild(ph);
+              list.forEach((e) => {
+                const o = document.createElement("option");
+                o.value = e.ja4;
+                o.textContent = e.ja4 + "  ·  " + (e.left || 0) + " scraper / " + (e.right || 0) + " device";
+                sel.appendChild(o);
+              });
+            } catch (e) {
+              sel.innerHTML = '<option value="">failed to load JA4 list</option>';
+            }
+            sel.addEventListener("change", () => render(sel.value));
+          }
+          // Re-fit when returning to the tab (container had no size while hidden).
+          window.dispatchEvent(new CustomEvent("va:shown"));
+        }
+
+        window.VA = { mount, render };
+      })();
+    </script>
