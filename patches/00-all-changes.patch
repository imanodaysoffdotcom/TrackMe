+	seedClient(t, s, "rand-a", "t13d1516h2_aaaa", "1.1.1.1")
+	seedClient(t, s, "rand-b", "t13d1517h2_bbbb", "2.2.2.2")
+	seedClient(t, s, "rand-c", "t13d1516h2_aaaa", "3.3.3.3") // same JA4 as A — must appear once
